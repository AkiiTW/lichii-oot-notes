From fbd26bc32050d4430748cc3bac1770d3b367080a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 6 Nov 2026 13:21:47 +0100
Subject: [PATCH] dist: keep textures and preload pipelines in the tuned
 package; no fixed texture thresholds

Measured on Ocarina (Ryzen 7 3800X): building every cached pipeline at boot kept the boot at
13 s and removed the stutters of effects seen in earlier sessions. A fixed
EDEN_NX2_TC_CRITICAL_MIB lowered the budget-following thresholds of Switch 2 titles.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HmEAGe4MCAJnHoeqq7Uysk
---
 dist/nx2_switches.txt | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/dist/nx2_switches.txt b/dist/nx2_switches.txt
index b2f9f0d19..8a972d29d 100644
--- a/dist/nx2_switches.txt
+++ b/dist/nx2_switches.txt
@@ -37,6 +37,15 @@ EDEN_NX2_PLACEMENT=split
 # comes back (the stutter of a first visit, again). 0 = never destroy.
 EDEN_NX2_PIPELINE_EVICT_FRAMES=0
 
+# Keep textures unused for ~75 s (they were decoded again on coming back). Leave the
+# EDEN_NX2_TC_EXPECTED_MIB / _CRITICAL_MIB thresholds alone for Switch 2 titles: the cache
+# already follows the driver's budget there, and a fixed value only lowers it (and is logged
+# again at every budget check).
+EDEN_NX2_TC_OLD_AGE=0
+
+# Build every cached pipeline at boot (longer boot, no stutter for a pipeline seen before).
+EDEN_NX2_PRELOAD_ALL_PIPELINES=1
+
 # Cap the pipeline (shader) builder threads (default: logical processors - 1).
 #EDEN_NX2_PIPELINE_WORKERS=6
 
-- 
