From 669f3f5f08bb5b9051bb22773ce6cd26e6f1480e Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 6 Nov 2026 13:48:07 +0100
Subject: [PATCH] lichii-tuned: instrument only the GPU emulation in the pgogen
 flavor

The whole-program instrumented build left Ocarina stuck at boot: every ZBIC NSO segment
failed to decompress (nso.cpp asserts), which the normal build of the same commit never
hit. LICHII_PGO_GENERATE_GPU instruments video_core and shader_recompiler only; the guest
CPU, services and loader run uninstrumented and at full speed.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HmEAGe4MCAJnHoeqq7Uysk
---
 .github/workflows/lichii-tuned.yml | 11 ++++++++---
 src/video_core/CMakeLists.txt      |  9 +++++++++
 2 files changed, 17 insertions(+), 3 deletions(-)

diff --git a/.github/workflows/lichii-tuned.yml b/.github/workflows/lichii-tuned.yml
index 48a2c8eb6..c1b4c8d72 100644
--- a/.github/workflows/lichii-tuned.yml
+++ b/.github/workflows/lichii-tuned.yml
@@ -4,7 +4,8 @@ name: lichii-tuned
 # YUZU_BUILD_PRESET. Three flavors, uploaded as artifacts (no release is made):
 #   normal  the PGO build;
 #   lto     the same with ThinLTO;
-#   pgogen  an instrumented build (-fprofile-generate) that writes default_*.profraw next to
+#   pgogen  a build with the GPU emulation instrumented (-fprofile-generate on video_core and
+#           shader_recompiler) that writes default_*.profraw next to
 #           lichii.exe when it exits normally.
 # Profiles: .profraw files (or .zip archives of them) committed under pgo/ are merged into the
 # profile the normal and lto flavors use, weighted over eglantine.profdata; without them,
@@ -143,8 +144,12 @@ jobs:
         shell: msys2 {0}
         run: |
           set -euo pipefail
+          gpu_pgo=OFF
           if [ '${{ matrix.flavor }}' = 'pgogen' ]; then
-            profile="-fprofile-generate"
+            # Only video_core and shader_recompiler are instrumented (LICHII_PGO_GENERATE_GPU):
+            # instrumenting everything left Ocarina stuck at boot (ZBIC NSO decompression failed).
+            profile=""
+            gpu_pgo=ON
           else
             profile="-fprofile-use=$(cygpath -m "$PWD/build/use.profdata") -Wno-backend-plugin \
               -Wno-profile-instr-unprofiled -Wno-profile-instr-out-of-date"
@@ -161,7 +166,7 @@ jobs:
           if [ '${{ matrix.flavor }}' = 'pgogen' ]; then
             linker="$linker -fprofile-generate"
           fi
-          cmake -S . -B build/release -G Ninja "${lto[@]}" \
+          cmake -S . -B build/release -G Ninja "${lto[@]}" -DLICHII_PGO_GENERATE_GPU=$gpu_pgo \
             -DCMAKE_BUILD_TYPE=Release \
             -DBUILD_TESTING=OFF \
             -DYUZU_TESTS=OFF \
diff --git a/src/video_core/CMakeLists.txt b/src/video_core/CMakeLists.txt
index 147462fb0..3f79896e6 100644
--- a/src/video_core/CMakeLists.txt
+++ b/src/video_core/CMakeLists.txt
@@ -555,3 +555,12 @@ if (ENABLE_NVIDIA_DLSS)
 endif()
 
 create_target_directory_groups(video_core)
+
+# Instrumented build for a GPU-side PGO profile (lichii-tuned's pgogen flavor): only the GPU
+# emulation is instrumented, so the guest CPU, the services and the loader run at full speed.
+# The whole-program instrumented build never got past the boot of Ocarina of Time.
+option(LICHII_PGO_GENERATE_GPU "Instrument video_core and shader_recompiler for PGO" OFF)
+if (LICHII_PGO_GENERATE_GPU)
+    target_compile_options(video_core PRIVATE -fprofile-generate)
+    target_compile_options(shader_recompiler PRIVATE -fprofile-generate)
+endif()
-- 
