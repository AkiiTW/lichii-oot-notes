@@ -74,25 +81,84 @@ jobs:
         uses: actions/cache/restore@v5
         with:
           path: .ccache
-          key: objects-tuned-${{ inputs.preset || 'zen2' }}-${{ matrix.lto }}-${{ github.sha }}-${{ github.run_id }}
+          key: objects-tuned-${{ inputs.preset || 'zen2' }}-${{ matrix.flavor }}-${{ github.sha }}-${{ github.run_id }}
           restore-keys: |
-            objects-tuned-${{ inputs.preset || 'zen2' }}-${{ matrix.lto }}-
+            objects-tuned-${{ inputs.preset || 'zen2' }}-${{ matrix.flavor }}-
+
+      # The profile runtime must link and its output must merge before an hour of instrumented
+      # build. MSYS2 may ship compiler-rt for another clang version than the compiler: its
+      # library is then copied where this clang looks for it.
+      - name: Check the profile runtime
+        if: matrix.flavor == 'pgogen'
+        shell: msys2 {0}
+        run: |
+          set -euo pipefail
+          cd "$(mktemp -d)"
+          printf 'int main(void) { return 0; }\n' > t.c
+          if ! clang -fprofile-generate -fuse-ld=lld t.c -o t.exe; then
+            lib=$(ls /ucrt64/lib/clang/*/lib/windows/libclang_rt.profile-x86_64.a | head -n 1)
+            dir=$(clang -print-runtime-dir)
+            echo "Copying $lib to $dir"
+            mkdir -p "$dir" "$(clang -print-resource-dir)/lib/windows"
+            cp "$lib" "$dir/libclang_rt.profile.a"
+            cp "$lib" "$dir/libclang_rt.profile-x86_64.a"
+            cp "$lib" "$(clang -print-resource-dir)/lib/windows/libclang_rt.profile-x86_64.a"
+            clang -fprofile-generate -fuse-ld=lld t.c -o t.exe
+          fi
+          ./t.exe
+          ls -la ./*.profraw
+          llvm-profdata merge -o t.profdata ./*.profraw
+          llvm-profdata show t.profdata | head -n 5
+
+      - name: Merge the Ocarina profile
+        if: matrix.flavor != 'pgogen'
+        shell: msys2 {0}
+        run: |
+          set -euo pipefail
+          shopt -s nullglob globstar
+          mkdir -p build/pgo
+          for archive in pgo/*.zip; do
+            unzip -o -q -d build/pgo "$archive"
+          done
+          raws=(pgo/*.profraw build/pgo/**/*.profraw)
+          if [ ${#raws[@]} -eq 0 ]; then
+            echo "No profile under pgo/: eglantine.profdata only"
+            cp eglantine.profdata build/use.profdata
+            exit 0
+          fi
+          echo "Ocarina profile from ${#raws[@]} file(s)"
+          weighted=()
+          for raw in "${raws[@]}"; do
+            weighted+=("--weighted-input=4,$raw")
+          done
+          if ! llvm-profdata merge -o build/use.profdata "${weighted[@]}" eglantine.profdata; then
+            echo "eglantine.profdata did not merge: the Ocarina profile alone"
+            llvm-profdata merge -o build/use.profdata "${raws[@]}"
+          fi
+          llvm-profdata show build/use.profdata | head -n 5
 
       - name: Configure
         shell: msys2 {0}
         run: |
           set -euo pipefail
-          profile="-fprofile-use=$(cygpath -m "$PWD/eglantine.profdata") -Wno-backend-plugin \
-            -Wno-profile-instr-unprofiled -Wno-profile-instr-out-of-date"
+          if [ '${{ matrix.flavor }}' = 'pgogen' ]; then
+            profile="-fprofile-generate"
+          else
+            profile="-fprofile-use=$(cygpath -m "$PWD/build/use.profdata") -Wno-backend-plugin \
+              -Wno-profile-instr-unprofiled -Wno-profile-instr-out-of-date"
+          fi
           # CMake's IPO check fails under MSYS2 clang (UseLTO.cmake stops the configure), so
           # ThinLTO goes in the flags directly, with LLVM's archiver for the bitcode objects.
           lto=()
           linker="-fuse-ld=lld"
-          if [ '${{ matrix.lto }}' = 'true' ]; then
+          if [ '${{ matrix.flavor }}' = 'lto' ]; then
             profile="$profile -flto=thin"
             linker="$linker -flto=thin"
             lto=(-DCMAKE_AR=/ucrt64/bin/llvm-ar.exe -DCMAKE_RANLIB=/ucrt64/bin/llvm-ranlib.exe)
           fi
+          if [ '${{ matrix.flavor }}' = 'pgogen' ]; then
+            linker="$linker -fprofile-generate"
+          fi
           cmake -S . -B build/release -G Ninja "${lto[@]}" \
             -DCMAKE_BUILD_TYPE=Release \
             -DBUILD_TESTING=OFF \
@@ -166,7 +232,7 @@ jobs:
