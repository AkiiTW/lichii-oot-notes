         uses: actions/upload-artifact@v7
         with:
-          name: lichii-windows-${{ inputs.preset || 'zen2' }}${{ matrix.lto && '-lto' || '' }}-${{ github.sha }}
+          name: lichii-windows-${{ inputs.preset || 'zen2' }}-${{ matrix.flavor }}-${{ github.sha }}
           path: build/release/bin/
           if-no-files-found: error
