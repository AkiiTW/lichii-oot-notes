From e941a3b894c48f43bc5a5e3892d4d44fc37b23e2 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 6 Nov 2026 15:33:27 +0100
Subject: [PATCH] vk_pipeline_cache: file shared cache entries under this
 driver version; raise the TC thresholds

A cache written under another NVIDIA driver version held keys draws never matched (the driver
fields only tell pipelines apart): with the same driver id the entry now takes this version, so
it is found, and doubles of it are dropped. The packaged switches raise the texture cache
thresholds over the 5 GiB cap that made Ocarina evict and re-decode the village's textures.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HmEAGe4MCAJnHoeqq7Uysk
---
 dist/nx2_switches.txt                           |  9 ++++++---
 .../renderer_vulkan/vk_pipeline_cache.cpp       | 17 +++++++++++++++++
 2 files changed, 23 insertions(+), 3 deletions(-)

diff --git a/dist/nx2_switches.txt b/dist/nx2_switches.txt
index f34f16e9a..7309ef062 100644
--- a/dist/nx2_switches.txt
+++ b/dist/nx2_switches.txt
@@ -38,9 +38,12 @@ EDEN_NX2_PLACEMENT=split
 EDEN_NX2_PIPELINE_EVICT_FRAMES=0
 
 # Keep textures unused for ~75 s (they were decoded again on coming back). Leave the
-# EDEN_NX2_TC_EXPECTED_MIB / _CRITICAL_MIB thresholds alone for Switch 2 titles: the cache
-# already follows the driver's budget there, and a fixed value only lowers it (and is logged
-# again at every budget check).
+# The texture cache collects from 5 GiB on (MaxCriticalMemory caps the driver budget it follows),
+# so on a 16 GB card Ocarina evicts the textures of the part of the village behind the camera and
+# decodes their ASTC again when the camera turns. Fixed thresholds win over that cap; keep them
+# a few GB under the card's budget (16 GB card: ~14 GB).
+EDEN_NX2_TC_EXPECTED_MIB=9216
+EDEN_NX2_TC_CRITICAL_MIB=11264
 EDEN_NX2_TC_OLD_AGE=0
 
 # Build every cached pipeline at boot (longer boot, no stutter for a pipeline seen before).
diff --git a/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp b/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
index 106829c5b..2adceba05 100644
--- a/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
+++ b/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
@@ -1205,7 +1205,10 @@ GraphicsPipeline* PipelineCache::CurrentGraphicsPipelineClean() {
     }
 
     TakeCleanSnapshot();
+    graphics_key.state.attribute_types = raw_attribute_types;
     graphics_key.state.Refresh(*maxwell3d, dynamic_features);
+    raw_attribute_types = graphics_key.state.attribute_types;
+    NormalizeVertexInputKey(graphics_key);
     if (current_pipeline) {
         GraphicsPipeline* const next{current_pipeline->Next(graphics_key)};
         if (next) {
@@ -1346,6 +1349,7 @@ void PipelineCache::LoadDiskResources(u64 title_id, std::stop_token stop_loading
     used_pipelines = LoadUsedPipelines(used_pipelines_filename, MaxUsedPipelineAge(device));
     used_pipelines_saved = std::chrono::steady_clock::now();
     size_t skipped_pipelines = 0;
+    size_t other_driver_versions = 0;
     size_t queued_graphics = 0;
     std::vector<std::pair<GraphicsPipelineCacheKey, std::vector<FileEnvironment>>> deferred_graphics;
 
@@ -1427,6 +1431,15 @@ void PipelineCache::LoadDiskResources(u64 title_id, std::stop_token stop_loading
             return;
         }
 
+        // A cache shared by another player was written under their driver version: the key's
+        // driver fields only tell pipelines apart (the SPIR-V and the pipeline are made for this
+        // device either way), so with the same driver the entry is filed under this version and
+        // draws find it.
+        if (key.state.driver_id == dynamic_features.driver_id &&
+            key.state.driver_version != dynamic_features.driver_version) {
+            key.state.driver_version = dynamic_features.driver_version;
+            ++other_driver_versions;
+        }
         const u64 hash = key.Hash();
         if (!disk_pipelines.insert(hash).second) {
             return;
@@ -1475,6 +1488,10 @@ void PipelineCache::LoadDiskResources(u64 title_id, std::stop_token stop_loading
                                load_graphics);
 
     LOG_INFO(Render_Vulkan, "Total Pipeline Count: {}", state.total);
+    if (other_driver_versions != 0) {
+        LOG_INFO(Render_Vulkan, "{} cached graphics pipelines came from another driver version",
+                 other_driver_versions);
+    }
     if (skipped_pipelines != 0) {
         LOG_INFO(Render_Vulkan,
                  "{} cached graphics pipelines are built when first needed",
-- 
