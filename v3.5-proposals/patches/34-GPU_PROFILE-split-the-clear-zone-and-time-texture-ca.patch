From d9bf5d902e0d653cb255a43f0b93ac939e494007 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 7 Nov 2026 20:31:44 +0100
Subject: [PATCH] GPU_PROFILE: split the clear zone and time texture cache
 creations

Clears cost the back ~70 ms/s in the market (~1,500/s, ~45 us each; 13 us after 20 min of play
earlier). New zones: clear targets (a clear finding its render targets and framebuffer), image
join, image create (VkImage + memory), view create, framebuffer create, tc tick (collector and
freeing at the end of the frame), to see whether the transient render targets' creations land in
the clears.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HmEAGe4MCAJnHoeqq7Uysk
---
 src/video_core/nx2_profile.h                     |  8 ++++++++
 src/video_core/renderer_vulkan/vk_rasterizer.cpp |  7 +++++--
 src/video_core/texture_cache/texture_cache.h     | 13 +++++++++++--
 3 files changed, 24 insertions(+), 4 deletions(-)

diff --git a/src/video_core/nx2_profile.h b/src/video_core/nx2_profile.h
index c56406dfc..2fb638c04 100644
--- a/src/video_core/nx2_profile.h
+++ b/src/video_core/nx2_profile.h
@@ -68,6 +68,12 @@ enum class Zone : u32 {
     UboBank,      ///< 64 KiB native banks uploaded again once per frame
     StorageBinds, ///< Graphics storage buffers bound with the stage's buffers
     TexBufBinds,  ///< Graphics texture buffers bound with the stage's buffers
+    ClearTargets, ///< A clear finding its render targets and framebuffer (UpdateRenderTargets)
+    ImageJoin,    ///< JoinImages outside the image creation below (overlaps, copies, setup)
+    ImageCreate,  ///< Host image made for a new cache image (VkImage + memory)
+    ViewCreate,   ///< Image view made for a cache image
+    FramebufferCreate, ///< Framebuffer made for a new set of render targets
+    TcTick,       ///< Texture cache end-of-frame work: collector, freeing sentenced images
     Count,
 };
 
@@ -81,6 +87,8 @@ inline constexpr std::array<const char*, static_cast<size_t>(Zone::Count)> zone_
     "fence skipped", "method", "split drain", "split wait",
     "writer wait", "list submit wait", "list GPU wait",
     "ubo fast",      "ubo classic",   "ubo bank",       "storage binds",  "texbuf binds",
+    "clear targets", "image join",    "image create",   "view create",    "framebuffer create",
+    "tc tick",
 };
 
 // Read once, when the GPU thread starts (Initialize): Enabled() runs several times per method
diff --git a/src/video_core/renderer_vulkan/vk_rasterizer.cpp b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
index 39be307ce..0bb67193f 100644
--- a/src/video_core/renderer_vulkan/vk_rasterizer.cpp
+++ b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
@@ -1311,8 +1311,11 @@ void RasterizerVulkan::Clear(u32 layer_count) {
     }
 
     std::scoped_lock lock{texture_cache.mutex};
-    texture_cache.UpdateRenderTargets(true);
-    const Framebuffer* const framebuffer = texture_cache.GetFramebuffer();
+    const Framebuffer* const framebuffer = [&] {
+        VideoCommon::Nx2Profile::Scope targets_scope{VideoCommon::Nx2Profile::Zone::ClearTargets};
+        texture_cache.UpdateRenderTargets(true);
+        return texture_cache.GetFramebuffer();
+    }();
     if (frame_dump.Capturing() || flash_watch.WatchesPasses()) {
         FrameDumpPass(framebuffer);
     }
diff --git a/src/video_core/texture_cache/texture_cache.h b/src/video_core/texture_cache/texture_cache.h
index e47fd6156..a021de3eb 100644
--- a/src/video_core/texture_cache/texture_cache.h
+++ b/src/video_core/texture_cache/texture_cache.h
@@ -314,6 +314,7 @@ void TextureCache<P>::ApplyThresholdOverrides(bool log) {
 
 template <class P>
 void TextureCache<P>::TickFrame() {
+    VideoCommon::Nx2Profile::Scope tick_scope{VideoCommon::Nx2Profile::Zone::TcTick};
     // Upload buffers grown for one huge image (title 1's 341 MiB terrain layer pools) are freed
     // rather than kept for the rest of the session.
     for (auto* const scratch : {&swizzle_data_buffer, &unswizzle_data_buffer}) {
@@ -983,6 +984,7 @@ FramebufferId TextureCache<P>::GetFramebufferId(const RenderTargets& key) {
         return id ? &slot_image_views[id] : nullptr;
     });
     ImageView* const depth_buffer = key.depth_buffer_id ? &slot_image_views[key.depth_buffer_id] : nullptr;
+    VideoCommon::Nx2Profile::Scope framebuffer_scope{VideoCommon::Nx2Profile::Zone::FramebufferCreate};
     runtime.FlushDeferredClear();
     framebuffer_id = slot_framebuffers.insert(runtime, color_buffers, depth_buffer, key);
     return framebuffer_id;
@@ -2657,6 +2659,7 @@ ImageId TextureCache<P>::InsertImage(const ImageInfo& info, GPUVAddr gpu_addr,
 
 template <class P>
 ImageId TextureCache<P>::JoinImages(const ImageInfo& info, GPUVAddr gpu_addr, DAddr cpu_addr) {
+    VideoCommon::Nx2Profile::Scope join_scope{VideoCommon::Nx2Profile::Zone::ImageJoin};
     ImageInfo new_info = info;
     const size_t size_bytes = CalculateGuestSizeInBytes(new_info);
     const bool broken_views = runtime.HasBrokenTextureViewFormats();
@@ -2766,7 +2769,10 @@ ImageId TextureCache<P>::JoinImages(const ImageInfo& info, GPUVAddr gpu_addr, DA
             }
         }
     }
-    const ImageId new_image_id = slot_images.insert(runtime, new_info, gpu_addr, cpu_addr);
+    const ImageId new_image_id = [&] {
+        VideoCommon::Nx2Profile::Scope create_scope{VideoCommon::Nx2Profile::Zone::ImageCreate};
+        return slot_images.insert(runtime, new_info, gpu_addr, cpu_addr);
+    }();
     Image& new_image = slot_images[new_image_id];
 
     new_image.allocation_tick = frame_tick;
@@ -3422,7 +3428,10 @@ ImageViewId TextureCache<P>::FindOrEmplaceImageView(ImageId image_id, const Imag
                  info.range.base.level, info.range.extent.levels, info.range.base.layer,
                  info.range.extent.layers);
     }
-    const ImageViewId image_view_id = slot_image_views.insert(runtime, info, image_id, image, slot_images);
+    const ImageViewId image_view_id = [&] {
+        VideoCommon::Nx2Profile::Scope view_scope{VideoCommon::Nx2Profile::Zone::ViewCreate};
+        return slot_image_views.insert(runtime, info, image_id, image, slot_images);
+    }();
     image.InsertView(info, image_view_id);
     return image_view_id;
 }
-- 
