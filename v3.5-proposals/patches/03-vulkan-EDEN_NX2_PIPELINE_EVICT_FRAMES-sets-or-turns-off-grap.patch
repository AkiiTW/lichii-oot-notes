From 0d993c99f985bac17148e4e1a1136dc4e10e6aff Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 6 Nov 2026 01:01:25 +0100
Subject: [PATCH] vulkan: EDEN_NX2_PIPELINE_EVICT_FRAMES sets or turns off
 graphics pipeline eviction

An evicted native pipeline is translated again on the GPU thread, 10-20 ms each on a
Ryzen 7 3800X in Ocarina, so coming back to a place stutters as on the first visit.
The tuned package's switches file turns eviction off.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HmEAGe4MCAJnHoeqq7Uysk
---
 dist/nx2_switches.txt                             |  5 +++++
 .../renderer_vulkan/vk_pipeline_cache.cpp         | 15 +++++++++++++--
 2 files changed, 18 insertions(+), 2 deletions(-)

diff --git a/dist/nx2_switches.txt b/dist/nx2_switches.txt
index a37e4d940..884bc54ac 100644
--- a/dist/nx2_switches.txt
+++ b/dist/nx2_switches.txt
@@ -31,6 +31,11 @@ EDEN_NX2_FENCE_BATCH=1
 # Which L3 domain gets the GPU threads (0 = the one with CPU 0; default: the last one).
 #EDEN_NX2_PLACEMENT_DOMAIN=0
 
+# Keep every built pipeline for the whole session. By default one unused for 9000 frames is
+# destroyed, and a Switch 2 program's pipeline is then translated again on the GPU thread when it
+# comes back (the stutter of a first visit, again). 0 = never destroy.
+EDEN_NX2_PIPELINE_EVICT_FRAMES=0
+
 # Cap the pipeline (shader) builder threads (default: logical processors - 1).
 #EDEN_NX2_PIPELINE_WORKERS=6
 
diff --git a/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp b/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
index 45d6cc352..7c198a406 100644
--- a/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
+++ b/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
@@ -1528,8 +1528,19 @@ void PipelineCache::EvictUnusedPipelines() {
     // Each built pipeline holds ~0.45 MB of driver memory and none was ever destroyed, so it grew
     // with every place a session went (title 1: 1,500 on its title screen alone). One unused for
     // this long is destroyed; it takes 2-3 ms to build again from the driver's pipeline cache.
-    constexpr u64 EvictAfterFrames = 9000;
-    if (frame_count <= EvictAfterFrames) {
+    // EXPERIMENT: a native program's pipeline is translated again on the GPU thread as well
+    // (10-20 ms each on a Ryzen 7 3800X in Ocarina), so returning to a place stutters as on the
+    // first visit. EDEN_NX2_PIPELINE_EVICT_FRAMES=<frames> sets the age, 0 never evicts.
+    static const u64 EvictAfterFrames = [] {
+        if (const char* value = std::getenv("EDEN_NX2_PIPELINE_EVICT_FRAMES"); value != nullptr) {
+            const u64 frames = std::strtoull(value, nullptr, 10);
+            LOG_INFO(Render_Vulkan, "Pipeline eviction: {}",
+                     frames == 0 ? std::string{"off"} : fmt::format("after {} frames", frames));
+            return frames;
+        }
+        return u64{9000};
+    }();
+    if (EvictAfterFrames == 0 || frame_count <= EvictAfterFrames) {
         return;
     }
     // Only while the cache is large: each one evicted is translated again on the GPU thread when
