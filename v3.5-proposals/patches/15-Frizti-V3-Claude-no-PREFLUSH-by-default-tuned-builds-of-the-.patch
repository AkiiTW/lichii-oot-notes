From 30a75df6d34127cfe4ddb7a79c151adce22850c9 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 7 Nov 2026 00:32:21 +0100
Subject: [PATCH] Frizti V3 + Claude: no PREFLUSH by default; tuned builds of
 the claude/v3-zen2 branch

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HmEAGe4MCAJnHoeqq7Uysk
---
 .github/workflows/lichii-tuned.yml | 1 +
 src/yuzu/main.cpp                  | 5 +++--
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/.github/workflows/lichii-tuned.yml b/.github/workflows/lichii-tuned.yml
index c1b4c8d72..3c1c6b644 100644
--- a/.github/workflows/lichii-tuned.yml
+++ b/.github/workflows/lichii-tuned.yml
@@ -21,6 +21,7 @@ on:
   push:
     branches:
       - claude/oot-zen2
+      - claude/v3-zen2
     paths:
       - "src/**"
       - "CMakeLists.txt"
diff --git a/src/yuzu/main.cpp b/src/yuzu/main.cpp
index 0af8775d9..48b61504b 100644
--- a/src/yuzu/main.cpp
+++ b/src/yuzu/main.cpp
@@ -144,8 +144,9 @@ constexpr std::pair<const char*, const char*> BuiltinSwitches[] = {
     {"EDEN_NX2_ACQUIRE_PRECHECK", "2"},   {"EDEN_NX2_MACRO_SINK", "1"},
     {"EDEN_NX2_COMPUTE_SINK", "1"},       {"EDEN_NX2_RING_PAIRS", "1"},
     {"EDEN_NX2_UBO_INPLACE", "1"},        {"EDEN_NX2_PIPELINE_CLEAN", "1"},
-    {"EDEN_NX2_LIST_WAIT_SKIP", "1"},     {"EDEN_NX2_PREFLUSH", "1"},
-    {"EDEN_NX2_SEM_FAST", "2"},
+    {"EDEN_NX2_LIST_WAIT_SKIP", "1"},     {"EDEN_NX2_SEM_FAST", "2"},
+    // Not EDEN_NX2_PREFLUSH=1: one-frame white flashes over the whole screen in Ocarina's forest
+    // paths (3 in 12 s with it, none without), as buffer_cache.h already notes.
 };
 
 static void LoadNx2Switches(const char* argv0) {
