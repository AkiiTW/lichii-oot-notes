From cfc32ad55a8a6fcddaa9a84d30bfe36848480320 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 6 Nov 2026 12:45:30 +0100
Subject: [PATCH] lichii-tuned: drop the lto flavor, its binary broke Ocarina
 at boot

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HmEAGe4MCAJnHoeqq7Uysk
---
 .github/workflows/lichii-tuned.yml | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/lichii-tuned.yml b/.github/workflows/lichii-tuned.yml
index 8ce7ec7ab..48a2c8eb6 100644
--- a/.github/workflows/lichii-tuned.yml
+++ b/.github/workflows/lichii-tuned.yml
@@ -38,7 +38,9 @@ jobs:
     strategy:
       fail-fast: false
       matrix:
-        flavor: [normal, lto, pgogen]
+        # lto stays out of the matrix: the ThinLTO + PGO binary broke Ocarina at boot (guest
+        # abort 12 s in, read of 0x2) where the same commit's normal build ran.
+        flavor: [normal, pgogen]
     env:
       CCACHE_DIR: ${{ github.workspace }}/.ccache
       CCACHE_MAXSIZE: 3000M
-- 
