         BindHostGraphicsTextureBuffers(stage);
     }
 }
@@ -1484,6 +1486,7 @@ void BufferCache<P>::BindHostGraphicsUniformBuffer(size_t stage, u32 index, u32
          !native_indirect_uniforms_this_frame.contains(device_addr)) &&
