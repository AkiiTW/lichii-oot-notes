From 715bf05ae76bc3163bd2e7e3f90a862438f0366b Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 7 Nov 2026 04:10:04 +0100
Subject: [PATCH] Profiling build: symbols flavor with lichii.pdb, thread usage
 forgets stopped threads, work notes

The symbols flavor is the normal build plus CodeView line tables and a PDB next to the exe, so
EDEN_NX2_SAMPLE names the functions that keep the GPU back thread busy in Ocarina's market.
CLAUDE.md records the measurements and the leads so far.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HmEAGe4MCAJnHoeqq7Uysk
---
 .github/workflows/lichii-tuned.yml | 10 +++++++++-
 src/common/nx2_thread_usage.cpp    | 19 ++++++++++++++++++-
 2 files changed, 27 insertions(+), 2 deletions(-)

diff --git a/.github/workflows/lichii-tuned.yml b/.github/workflows/lichii-tuned.yml
index 3c1c6b644..6e8778b48 100644
--- a/.github/workflows/lichii-tuned.yml
+++ b/.github/workflows/lichii-tuned.yml
@@ -4,6 +4,8 @@ name: lichii-tuned
 # YUZU_BUILD_PRESET. Three flavors, uploaded as artifacts (no release is made):
 #   normal  the PGO build;
 #   lto     the same with ThinLTO;
+#   symbols the normal build plus CodeView line tables and lichii.pdb next to the exe, so the
+#           built-in sampler (EDEN_NX2_SAMPLE) names functions on the player's PC;
 #   pgogen  a build with the GPU emulation instrumented (-fprofile-generate on video_core and
 #           shader_recompiler) that writes default_*.profraw next to
 #           lichii.exe when it exits normally.
@@ -42,7 +44,7 @@ jobs:
       matrix:
         # lto stays out of the matrix: the ThinLTO + PGO binary broke Ocarina at boot (guest
         # abort 12 s in, read of 0x2) where the same commit's normal build ran.
-        flavor: [normal, pgogen]
+        flavor: [normal, pgogen, symbols]
     env:
       CCACHE_DIR: ${{ github.workspace }}/.ccache
       CCACHE_MAXSIZE: 3000M
@@ -167,6 +169,11 @@ jobs:
           if [ '${{ matrix.flavor }}' = 'pgogen' ]; then
             linker="$linker -fprofile-generate"
           fi
+          if [ '${{ matrix.flavor }}' = 'symbols' ]; then
+            # Line tables only: the same optimized code, with names and lines for dbghelp.
+            profile="$profile -gline-tables-only -gcodeview"
+            linker="$linker -Wl,--pdb="
+          fi
           cmake -S . -B build/release -G Ninja "${lto[@]}" -DLICHII_PGO_GENERATE_GPU=$gpu_pgo \
             -DCMAKE_BUILD_TYPE=Release \
             -DBUILD_TESTING=OFF \
@@ -214,6 +221,7 @@ jobs:
           cd build/release/bin
           test -f lichii.exe
           test -f eden-cli.exe
+          if [ '${{ matrix.flavor }}' = 'symbols' ]; then test -f lichii.pdb; fi
           windeployqt6 --no-translations --no-compiler-runtime --no-opengl-sw \
             --no-system-dxc-compiler --no-system-d3d-compiler lichii.exe
           deps() {
diff --git a/src/common/nx2_thread_usage.cpp b/src/common/nx2_thread_usage.cpp
index def8186cc..27a5167bc 100644
--- a/src/common/nx2_thread_usage.cpp
+++ b/src/common/nx2_thread_usage.cpp
@@ -89,11 +89,28 @@ void Monitor() {
                 const double percent =
                     static_cast<double>(total - std::min(total, entry.last)) / wall_100ns * 100.0;
                 entry.last = total;
+                named += percent;
+                // Threads of a stopped game are counted one last time, then forgotten: a game
+                // started again in the same session would otherwise show every name twice.
+                DWORD exit_code{};
+                if (GetExitCodeThread(entry.handle, &exit_code) && exit_code != STILL_ACTIVE) {
+                    if (percent > 0.0) {
+                        by_name[entry.name].first += percent;
+                    }
+                    continue;
+                }
                 auto& [sum, count] = by_name[entry.name];
                 sum += percent;
                 ++count;
-                named += percent;
             }
+            std::erase_if(entries, [](const Entry& entry) {
+                DWORD exit_code{};
+                if (GetExitCodeThread(entry.handle, &exit_code) && exit_code != STILL_ACTIVE) {
+                    CloseHandle(entry.handle);
+                    return true;
+                }
+                return false;
+            });
         }
         std::vector<std::pair<double, std::string>> sorted;
         for (const auto& [name, usage] : by_name) {
-- 
2.43.0

