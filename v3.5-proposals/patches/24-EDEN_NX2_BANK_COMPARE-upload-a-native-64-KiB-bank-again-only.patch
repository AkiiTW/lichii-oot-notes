From d4738fce03c4a077fa77af23b741ddc00fcadbbd Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 7 Nov 2026 15:15:34 +0100
Subject: [PATCH] EDEN_NX2_BANK_COMPARE: upload a native 64 KiB bank again only
 when its bytes changed

Ocarina's market re-uploads ~4,000 banks a second (~180 MB/s, ~33 ms of the GPU back thread).
With the switch on, each bank's bytes are kept from its last upload and compared first; the
profile counts the bytes uploaded and the bytes found unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HmEAGe4MCAJnHoeqq7Uysk
---
 src/video_core/buffer_cache/buffer_cache.h    | 34 ++++++++++++++++++-
 .../buffer_cache/buffer_cache_base.h          |  7 ++++
 src/video_core/nx2_profile.h                  |  6 +++-
 3 files changed, 45 insertions(+), 2 deletions(-)

diff --git a/src/video_core/buffer_cache/buffer_cache.h b/src/video_core/buffer_cache/buffer_cache.h
index 7e2df28fe..95c83b084 100644
--- a/src/video_core/buffer_cache/buffer_cache.h
+++ b/src/video_core/buffer_cache/buffer_cache.h
@@ -1494,7 +1494,35 @@ void BufferCache<P>::BindHostGraphicsUniformBuffer(size_t stage, u32 index, u32
             mapped_size += Core::DEVICE_PAGESIZE - ((device_addr + mapped_size) & Core::DEVICE_PAGEMASK);
         }
         const u64 upload_size = (std::min<u64>)(mapped_size, size);
-        if (upload_size != 0) {
+        // EDEN_NX2_BANK_COMPARE=1: upload only banks whose bytes changed since their last upload
+        // into this buffer. Exact: the host copy is only written by uploads of guest bytes or by
+        // the GPU, and a GPU-written bank never reaches this point (checked above).
+        static const bool bank_compare = [] {
+            const char* value = std::getenv("EDEN_NX2_BANK_COMPARE");
+            const bool on = value != nullptr && value[0] == '1';
+            LOG_INFO(HW_GPU, "EDEN_NX2_BANK_COMPARE: {}", on ? "on" : "off");
+            return on;
+        }();
+        bool unchanged = false;
+        if (bank_compare && upload_size != 0) {
+            BankShadow& shadow = bank_shadows[device_addr];
+            // GetSpan: the bank's bytes when they are contiguous in host memory, else null.
+            const u8* const guest = device_memory.GetSpan(device_addr, upload_size);
+            const bool contiguous = guest != nullptr;
+            if (contiguous && shadow.buffer_id == binding.buffer_id &&
+                shadow.bytes.size() == upload_size &&
+                std::memcmp(shadow.bytes.data(), guest, upload_size) == 0) {
+                unchanged = true;
+            } else if (contiguous) {
+                shadow.buffer_id = binding.buffer_id;
+                shadow.bytes.assign(guest, guest + upload_size);
+            } else {
+                bank_shadows.erase(device_addr);
+            }
+        }
+        if (unchanged) {
+            Nx2Profile::Add(Nx2Profile::Counter::UboBankSkipped, upload_size);
+        } else if (upload_size != 0) {
             std::array<BufferCopy, 1> copies{BufferCopy{
                 .src_offset = 0,
                 .dst_offset = buffer.Offset(device_addr),
@@ -2951,6 +2979,10 @@ void BufferCache<P>::DownloadBufferMemory(Buffer& buffer, DAddr device_addr, u64
 
 template <class P>
 void BufferCache<P>::DeleteBuffer(BufferId buffer_id, bool do_not_mark) {
+    // A slot id is reused by the next buffer: forget the bank copies made into this one.
+    std::erase_if(bank_shadows, [buffer_id](const auto& entry) {
+        return entry.second.buffer_id == buffer_id;
+    });
     if constexpr (requires { runtime.OnBufferDeleted(slot_buffers[buffer_id]); }) {
         runtime.OnBufferDeleted(slot_buffers[buffer_id]);
     }
diff --git a/src/video_core/buffer_cache/buffer_cache_base.h b/src/video_core/buffer_cache/buffer_cache_base.h
index 523b2f7ea..a9efaa809 100644
--- a/src/video_core/buffer_cache/buffer_cache_base.h
+++ b/src/video_core/buffer_cache/buffer_cache_base.h
@@ -470,6 +470,13 @@ public:
     bool any_buffer_uploaded = false;
     /// Indirectly read banks of native programs already uploaded this frame.
     std::unordered_set<DAddr> native_indirect_uniforms_this_frame;
+    /// EDEN_NX2_BANK_COMPARE: the bytes each bank had when it was last uploaded, by address. A
+    /// bank whose guest bytes still match is not uploaded again (its host copy holds them).
+    struct BankShadow {
+        BufferId buffer_id;
+        std::vector<u8> bytes;
+    };
+    std::unordered_map<DAddr, BankShadow> bank_shadows;
 
 private:
     template <typename Func>
diff --git a/src/video_core/nx2_profile.h b/src/video_core/nx2_profile.h
index d30a3a835..c56406dfc 100644
--- a/src/video_core/nx2_profile.h
+++ b/src/video_core/nx2_profile.h
@@ -260,6 +260,7 @@ enum class Counter : u32 {
     UboClassicBytes,  ///< Bytes of uniform buffers bound by the classic path
     UboClassicSynced, ///< Classic binds whose SynchronizeBuffer found CPU-written data to upload
     UboBankBytes,     ///< Bytes of 64 KiB native banks uploaded again
+    UboBankSkipped,   ///< EDEN_NX2_BANK_COMPARE: bank bytes unchanged since the last upload
     Count,
 };
 static_assert(static_cast<size_t>(Counter::Count) <= 64, "Counter outgrew the counters array");
@@ -440,11 +441,14 @@ inline void Report(const char* thread_name = "GPU thread") {
                        : 0.0;
         };
         line += fmt::format(" | uniform buffer sizes: fast {:.0f} B each, classic {:.0f} B each "
-                            "({:.0f}/s with CPU-written data), banks {:.0f} KiB/s",
+                            "({:.0f}/s with CPU-written data), banks {:.0f} KiB/s uploaded, "
+                            "{:.0f} KiB/s unchanged",
                             bytes_each(Counter::UboFastBytes, Zone::UboFast),
                             bytes_each(Counter::UboClassicBytes, Zone::UboClassic),
                             per_second(data.counters[static_cast<size_t>(Counter::UboClassicSynced)]),
                             per_second(data.counters[static_cast<size_t>(Counter::UboBankBytes)]) /
+                                1024.0,
+                            per_second(data.counters[static_cast<size_t>(Counter::UboBankSkipped)]) /
                                 1024.0);
     }
     if (const u64 early = data.counters[static_cast<size_t>(Counter::DmaReadsEarly)]; early != 0) {
-- 
